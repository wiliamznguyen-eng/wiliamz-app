<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wiliamz PRO</title>

<link rel="manifest" href="manifest.json">

<style>
body {
    margin:0;
    font-family:-apple-system;
    background:#000;
    color:white;
}

.header {
    padding:20px;
    font-size:22px;
    font-weight:bold;
}

.card {
    background:#1c1c1e;
    margin:15px;
    border-radius:15px;
    padding:15px;
}

.row {
    display:flex;
    justify-content:space-between;
    padding:12px 0;
    border-bottom:1px solid #333;
}

.switch {
    width:50px;
    height:28px;
    background:#555;
    border-radius:20px;
    position:relative;
}

.switch::after {
    content:"";
    width:24px;
    height:24px;
    background:white;
    position:absolute;
    top:2px;
    left:2px;
    border-radius:50%;
}

.active {
    background:#34c759;
}
</style>
</head>

<body>

<div id="login" class="card">
    <h3>Nhập Key</h3>
    <input id="key" placeholder="Key..." style="width:100%;padding:10px;border-radius:10px;border:none;">
    <button onclick="login()" style="margin-top:10px;padding:10px;width:100%">Xác nhận</button>
    <p id="msg"></p>
</div>

<div id="app" style="display:none">
    <div class="header">Wiliamz PRO</div>
    <div class="card" id="features"></div>
</div>

<script>
const API = "https://your-server.com/check";

async function login(){
    let key = document.getElementById("key").value;

    let res = await fetch(API,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
            key:key,
            device:navigator.userAgent
        })
    });

    let data = await res.json();

    if(data.success){
        localStorage.setItem("token",data.token);
        startApp();
    }else{
        document.getElementById("msg").innerText = data.msg;
    }
}

function startApp(){
    document.getElementById("login").style.display="none";
    document.getElementById("app").style.display="block";

    let box = document.getElementById("features");

    for(let i=1;i<=8;i++){
        let row = document.createElement("div");
        row.className="row";

        let sw = document.createElement("div");
        sw.className="switch";

        sw.onclick=()=>sw.classList.toggle("active");

        row.innerHTML=`<span>Chức năng ${i}</span>`;
        row.appendChild(sw);

        box.appendChild(row);
    }
}

if(localStorage.getItem("token")){
    startApp();
}
</script>

</body>
</html>
